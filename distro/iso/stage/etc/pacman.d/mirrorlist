# Where pacman downloads packages from. Arch's own list comes with every server
# commented out; btw starts with Arch's worldwide mirrors, which send you to
# one near you. Put servers you prefer at the top, or make a list of fast ones
# near you with reflector (sudo pacman -S reflector, then man reflector).
Server = https://geo.mirror.pkgbuild.com/$repo/os/$arch
Server = https://fastly.mirror.pkgbuild.com/$repo/os/$arch
Server = https://mirror.rackspace.com/archlinux/$repo/os/$arch
