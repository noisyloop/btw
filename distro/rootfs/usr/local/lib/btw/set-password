#!/bin/sh
# Sets the first password of btw's user, once. A new btw has none (the Mac
# VM and the live USB log in by themselves on their own screen; on Windows,
# WSL does), so nothing can sudo or log in with a password everyone knows.
# The welcome terminal runs this through sudo without a password, which
# sudoers allows for this one script with no arguments, and it only works
# while /var/lib/btw/choose-password exists: after that it's plain `passwd`.
#
# The marker is root's and names the user (btw when it's empty), so the
# password set is never one the caller picks.
set -eu
marker=/var/lib/btw/choose-password
if [ ! -e "$marker" ] || [ -L "$marker" ]; then
    echo "btw already has a password; change it with passwd" >&2
    exit 1
fi
user=$(head -n 1 "$marker" | tr -cd 'a-z0-9_-')
user=${user:-btw}
uid=$(id -u "$user" 2>/dev/null) || { echo "set-password: no user called $user" >&2; exit 1; }
[ "$uid" -ge 1000 ] || { echo "set-password: $user isn't a normal user" >&2; exit 1; }
passwd "$user"
rm -f "$marker"
