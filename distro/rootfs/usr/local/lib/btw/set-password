#!/bin/sh
# Sets the btw user's first password, once. A new btw VM has none (it logs
# in by itself on its own screen), so nothing can sudo or log in with a
# password everyone knows. The welcome terminal runs this through sudo
# without a password, allowed by /etc/sudoers.d/wheel, but only while
# /var/lib/btw/choose-password exists: after that it's plain `passwd`.
set -eu
marker=/var/lib/btw/choose-password
if [ ! -e "$marker" ]; then
    echo "btw already has a password; change it with passwd" >&2
    exit 1
fi
passwd btw
rm -f "$marker"
