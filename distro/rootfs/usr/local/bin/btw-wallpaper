#!/bin/sh
# Draws btw's wallpaper: the live, slowly orbiting 3D fractal (Quickshell and
# a GPU), or a still picture of the same fractal (swaybg) when there's no GPU
# to spare, as in the Mac VM. Its settings are in ~/.config/btw/wallpaper.conf, shared
# with the Fractals app (btw-fractals), which changes them live.
#
#   btw-wallpaper start         start it (Sway runs this at login)
#   btw-wallpaper set <name>    switch fractal: mandelbulb, mandelbox, sierpinski, menger
#   btw-wallpaper still|live    use the picture, or the live fractal again
#   btw-wallpaper list          print the fractals, the current one marked
#
# Like btw-bar, it stops only what it started in this btw session.
set -u

conf="${XDG_CONFIG_HOME:-$HOME/.config}/btw/wallpaper.conf"
shell=/usr/share/btw/wallpaper
stills=/usr/share/backgrounds/btw
log="$HOME/.local/state/btw-wallpaper.log"
pids="${XDG_RUNTIME_DIR:-/tmp}/btw-wallpaper.$(basename "${SWAYSOCK:-default}").pids"
fractals="mandelbulb mandelbox sierpinski menger"

get() { # get <key> <default>
    v=$(sed -n "s/^$1=//p" "$conf" 2>/dev/null | tail -n 1)
    echo "${v:-$2}"
}

put() { # put <key> <value>
    mkdir -p "$(dirname "$conf")"
    tmp="$conf.$$"
    { grep -v "^$1=" "$conf" 2>/dev/null; echo "$1=$2"; } >"$tmp" && mv "$tmp" "$conf"
}

fractal() {
    f=$(get fractal mandelbulb)
    case " $fractals " in *" $f "*) echo "$f" ;; *) echo mandelbulb ;; esac
}

live() {
    [ "$(get mode live)" = still ] && return 1
    # Without a GPU, Sway draws with pixman and Qt can't run shaders.
    [ "${WLR_RENDERER:-}" = pixman ] && return 1
    command -v quickshell >/dev/null && [ -f "$shell/shell.qml" ]
}

ours() {
    [ -f "$pids" ] || return 0
    while read -r pid; do
        case "$(tr '\0' ' ' 2>/dev/null <"/proc/$pid/cmdline")" in
        *"quickshell -p $shell"* | *"swaybg"*"$stills/"*) echo "$pid" ;;
        esac
    done <"$pids"
}

stop() {
    list=$(ours)
    [ -n "$list" ] && kill $list 2>/dev/null
    rm -f "$pids"
}

still() {
    picture="$stills/$(fractal).png"
    [ -f "$picture" ] || picture="$stills/fractal.png"
    setsid swaybg -o '*' -i "$picture" -m fill >>"$log" 2>&1 </dev/null &
    echo $! >>"$pids"
}

# Whether this session's wallpaper is the live one (it then follows
# wallpaper.conf by itself; a still picture has to be swapped).
showing_live() {
    for pid in $(ours); do
        case "$(tr '\0' ' ' 2>/dev/null <"/proc/$pid/cmdline")" in *quickshell*) return 0 ;; esac
    done
    return 1
}

start() {
    mkdir -p "$(dirname "$log")" "$(dirname "$pids")"
    : >"$log"
    old=$(ours)
    new=
    if live; then
        QT_QPA_PLATFORM=wayland setsid quickshell -p "$shell" >>"$log" 2>&1 </dev/null &
        new=$!
        # If it can't draw (no shader support), fall back to the picture.
        sleep 1.5
        if ! kill -0 "$new" 2>/dev/null; then
            echo "btw-wallpaper: the live wallpaper quit; showing the picture" >>"$log"
            new=
        fi
    fi
    # Swap without a gap: the new wallpaper is up before the old one goes.
    [ -n "$old" ] && kill $old 2>/dev/null
    rm -f "$pids"
    if [ -n "$new" ]; then echo "$new" >"$pids"; else still; fi
}

case "${1:-start}" in
start) start ;;
stop) stop ;;
set)
    case " $fractals " in
    *" ${2:-} "*) ;;
    *) echo "usage: btw-wallpaper set <$(echo $fractals | tr ' ' '|')>" >&2; exit 2 ;;
    esac
    # The live wallpaper watches the file and changes on its own; a still
    # picture is swapped for the new fractal's.
    put fractal "$2"
    showing_live || start
    ;;
still | live)
    put mode "$1" && start
    ;;
list)
    cur=$(fractal)
    for f in $fractals; do [ "$f" = "$cur" ] && echo "* $f" || echo "  $f"; done
    ;;
*)
    echo "usage: btw-wallpaper [start|set <fractal>|still|live|list]" >&2
    exit 2
    ;;
esac
