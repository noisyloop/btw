#!/bin/sh
# Starts the btw desktop: Sway with btw's own config. Runs from the login
# screen (the "btw" session) or from a text console. Exiting the desktop
# (Super+Shift+E) returns to wherever it was started from.
#
# Started inside another desktop (e.g. from Omarchy's app menu or terminal),
# btw opens in a window instead. It detaches, so closing the terminal doesn't
# close btw, and it uses Alt where it would use Super, since the desktop
# around it keeps the Super shortcuts. Leave it with Alt+Shift+E.
#
#   btw-session               start btw (detached when inside another desktop)
#   btw-session --foreground  stay attached and print everything, for debugging
#
# If btw doesn't come up, the reason is shown (and is in ~/.local/state/sway.log).
log="$HOME/.local/state/sway.log"
mkdir -p "$HOME/.local/state"
foreground=
[ "${1:-}" = --foreground ] && { foreground=yes; shift; }

config=/usr/share/btw/config/sway/config
if [ -n "${WAYLAND_DISPLAY:-}" ]; then
    if [ -z "${BTW_DETACHED:-}" ] && [ -z "$foreground" ]; then
        # Start btw in its own session, then wait a moment to see whether it
        # stays up: if it quits, say why instead of failing silently.
        BTW_DETACHED=1 setsid "$0" "$@" </dev/null >/dev/null 2>&1 &
        pid=$!
        i=0
        while [ $i -lt 30 ] && kill -0 "$pid" 2>/dev/null; do
            sleep 0.1
            i=$((i + 1))
        done
        if kill -0 "$pid" 2>/dev/null; then
            exit 0
        fi
        reason=$(grep -iE 'error|fail|unable|cannot|could not' "$log" 2>/dev/null | tail -n 3)
        [ -n "$reason" ] || reason=$(tail -n 3 "$log" 2>/dev/null)
        echo "btw didn't start. From $log:" >&2
        echo "$reason" >&2
        echo "For the full output, run: btw-session --foreground" >&2
        command -v notify-send >/dev/null &&
            notify-send -u critical "btw didn't start" "$reason

Details: $log, or run btw-session --foreground in a terminal."
        exit 1
    fi
    # Alt instead of Super, and without /etc/sway/config.d: Arch's
    # 50-systemd-user.conf there tells the whole login that the desktop is
    # now Sway, which would confuse the desktop around the window (Omarchy's
    # launcher would hide apps and send new windows to btw).
    window="${XDG_RUNTIME_DIR:-/tmp}/btw-window.conf"
    sed -e 's/^set \$mod Mod4$/set $mod Mod1/' -e '/^include \/etc\/sway\/config\.d\//d' "$config" >"$window"
    config=$window
fi

# Without a real GPU (the Mac VM's virtio-gpu, or no render node at all),
# wlroots renders with pixman on the CPU and draws its own cursor.
gpu=
for d in /sys/class/drm/card[0-9]*/device/driver; do
    [ -e "$d" ] || continue
    case "$(basename "$(readlink "$d")")" in
    virtio_gpu | virtio-pci) ;;
    *) gpu=yes ;;
    esac
done
[ -e /dev/dri/renderD128 ] || gpu=
if [ -z "$gpu" ]; then
    export WLR_RENDERER="${WLR_RENDERER:-pixman}"
    export WLR_NO_HARDWARE_CURSORS=1
fi

export XDG_CURRENT_DESKTOP=sway
export XDG_SESSION_DESKTOP=btw
export XDG_SESSION_TYPE=wayland
export MOZ_ENABLE_WAYLAND=1
export QT_QPA_PLATFORM="wayland;xcb"

# Sway won't start on NVIDIA's proprietary driver without this flag.
set --
[ -d /sys/module/nvidia_drm ] && set -- --unsupported-gpu

# What btw-session decided, at the top of the log, then Sway's own output.
{
    echo "btw-session $(date '+%F %T')"
    if [ -n "${WAYLAND_DISPLAY:-}" ]; then
        echo "  in a window, inside $WAYLAND_DISPLAY"
    else
        echo "  full screen"
    fi
    echo "  renderer: ${WLR_RENDERER:-GPU} ${*:+(sway $*)}"
    echo "  config: $config"
    echo "  sway: $(command -v sway || echo 'not installed')"
} >"$log"
if ! command -v sway >/dev/null; then
    echo "sway isn't installed; run ./install.sh again" | tee -a "$log" >&2
    exit 1
fi
if [ -n "$foreground" ]; then
    sway "$@" --config "$config" 2>&1 | tee -a "$log"
    exit
fi
exec sway "$@" --config "$config" >>"$log" 2>&1
