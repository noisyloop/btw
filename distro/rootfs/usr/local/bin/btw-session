#!/bin/sh
# Starts the btw desktop: Sway with btw's own config.
#
# From the login screen (the "btw" session) or a text console, btw is the
# whole desktop. Super+Shift+E leaves it.
#
# Inside another desktop (e.g. Omarchy), btw opens in a window, using Alt
# where it would use Super, since the desktop around it keeps the Super
# shortcuts. Alt+Shift+E closes it. From the app menu or a terminal, it runs
# as its own systemd user service, so closing the terminal doesn't close it.
#
#   btw-session               start btw
#   btw-session --foreground  stay in the terminal and print everything
#
# Sway's output is in ~/.local/state/sway.log; if btw quits with an error,
# a notification says why.
log="$HOME/.local/state/sway.log"
mkdir -p "$HOME/.local/state"
foreground=
[ "${1:-}" = --foreground ] && { foreground=yes; shift; }

config=/usr/share/btw/config/sway/config
if [ -n "${WAYLAND_DISPLAY:-}" ]; then
    # Hand btw to the login's own systemd, as a service of its own, and give
    # control back. Run as a child of the terminal or the app launcher, btw
    # shares their clean-up, and on Omarchy something there kills it (signal
    # 9) before its window appears. As its own service it belongs to neither.
    if [ -z "$foreground" ] && [ -z "${BTW_STARTED:-}" ]; then
        opened() {
            [ -t 1 ] && echo "btw is opening in a window. Alt+Shift+E closes it."
            exit 0
        }
        if command -v systemd-run >/dev/null; then
            # A service starts with the login's environment, not ours, so pass
            # along what btw needs from here.
            set -- --setenv=BTW_STARTED=1
            for v in WAYLAND_DISPLAY DISPLAY PATH LANG XDG_DATA_DIRS XDG_CONFIG_DIRS DBUS_SESSION_BUS_ADDRESS; do
                eval "[ -n \"\${$v:-}\" ]" && set -- "$@" "--setenv=$v"
            done
            systemd-run --user --quiet --collect --unit="btw-window-$(date +%s)-$$" \
                "$@" "$0" >/dev/null 2>&1 && opened
        fi
        # No user systemd: start it in a session of its own instead.
        BTW_STARTED=1 setsid -f "$0" </dev/null >/dev/null 2>&1
        opened
    fi
    # Alt instead of Super, and without /etc/sway/config.d: Arch's
    # 50-systemd-user.conf there tells the whole login that the desktop is
    # now Sway, which would confuse the desktop around the window (Omarchy's
    # launcher would hide apps and send new windows to btw).
    window="${XDG_RUNTIME_DIR:-/tmp}/btw-window.conf"
    sed -e 's/^set \$mod Mod4$/set $mod Mod1/' -e '/^include \/etc\/sway\/config\.d\//d' "$config" >"$window"
    # Closing the window takes away Sway's only display, but Sway itself keeps
    # running, unseen, with its bar and wallpaper. Quit once the display is
    # gone, so closing the window closes btw.
    cat >>"$window" <<'EOF2'

exec sh -c 'sleep 5; while swaymsg -t get_outputs | grep -q "\"name\""; do sleep 2; done; swaymsg exit'
EOF2
    config=$window
fi

# Without a real GPU (the Mac VM's virtio-gpu, or no render node at all),
# wlroots renders with pixman on the CPU and draws its own cursor.
gpu=
for d in /sys/class/drm/card[0-9]*/device/driver; do
    [ -e "$d" ] || continue
    case "$(basename "$(readlink "$d")")" in
    virtio_gpu | virtio-pci) ;;
    *) gpu=yes ;;
    esac
done
[ -e /dev/dri/renderD128 ] || gpu=
if [ -z "$gpu" ]; then
    export WLR_RENDERER="${WLR_RENDERER:-pixman}"
    export WLR_NO_HARDWARE_CURSORS=1
fi

export XDG_CURRENT_DESKTOP=sway
export XDG_SESSION_DESKTOP=btw
export XDG_SESSION_TYPE=wayland
export MOZ_ENABLE_WAYLAND=1
export QT_QPA_PLATFORM="wayland;xcb"

# Sway won't start on NVIDIA's proprietary driver without this flag.
set --
[ -d /sys/module/nvidia_drm ] && set -- --unsupported-gpu

if ! command -v sway >/dev/null; then
    echo "sway isn't installed; run ./install.sh again" >&2
    command -v notify-send >/dev/null && notify-send -u critical "btw" "sway isn't installed; run ./install.sh again"
    exit 1
fi

# What btw-session decided, at the top of the log, then Sway's own output.
header() {
    echo "btw-session $(date '+%F %T')"
    if [ -n "${WAYLAND_DISPLAY:-}" ]; then
        echo "  in a window, inside $WAYLAND_DISPLAY"
    else
        echo "  full screen"
    fi
    echo "  renderer: ${WLR_RENDERER:-GPU} ${*:+(sway $*)}"
    echo "  config: $config"
}

if [ -n "$foreground" ]; then
    header "$@" >"$log"
    sway "$@" --config "$config" 2>&1 | tee -a "$log"
    exit
fi

# Full screen: Sway is the session, nothing to come back to.
if [ -z "${WAYLAND_DISPLAY:-}" ]; then
    header "$@" >"$log"
    exec sway "$@" --config "$config" >>"$log" 2>&1
fi

# In a window: run Sway, and if it quits with an error, say why. If it fails
# straight away on the GPU (some drivers don't allow Sway inside another
# desktop), try once more drawing on the CPU.
run() {
    header "$@" >"$log"
    started=$(date +%s)
    sway "$@" --config "$config" >>"$log" 2>&1
    status=$?
    if [ $status -gt 128 ]; then
        echo "sway was stopped by signal $((status - 128)) ($(kill -l $((status - 128)) 2>/dev/null))" >>"$log"
    else
        echo "sway exited with status $status" >>"$log"
    fi
    return $status
}

run "$@"
status=$?
if [ $status -ne 0 ] && [ -z "${WLR_RENDERER:-}" ] && [ $(($(date +%s) - started)) -lt 5 ]; then
    cp "$log" "$log.gpu"
    export WLR_RENDERER=pixman
    run "$@"
    status=$?
fi

# 0 is a normal close (Alt+Shift+E or closing the window).
if [ $status -ne 0 ]; then
    # Sway's own messages, not those of the programs it started (swaybg,
    # waybar, ...), which only report that Sway went away.
    reason=$(grep -v -e 'swaybg' -e 'waybar' -e 'mako' -e 'quickshell' -e 'foot' "$log" |
        grep -iE 'error|fail|unable|cannot|could not|abort|sway (exited|was stopped)' | tail -n 4)
    command -v notify-send >/dev/null &&
        notify-send -u critical "btw closed unexpectedly" "$reason

Details: $log"
fi
exit $status
