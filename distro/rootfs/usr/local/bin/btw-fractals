#!/bin/sh
# Opens the Fractals app, which picks and tunes the wallpaper. If it's already
# open, brings it to the front instead.
app=/usr/share/btw/wallpaper/fractals.qml
if pgrep -f "quickshell -n -p $app" >/dev/null; then
    exec swaymsg -q '[title="^Fractals$"] focus'
fi
QT_QPA_PLATFORM=wayland exec setsid quickshell -n -p "$app" </dev/null >/dev/null 2>&1
