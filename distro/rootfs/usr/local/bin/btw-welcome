#!/bin/sh
# The terminal btw opens when the desktop starts: fastfetch, then a shell.
# On a new btw, which has no password yet (the Mac VM, the live USB, btw on
# Windows), it first asks for one.
if [ -e /var/lib/btw/choose-password ] && [ -x /usr/local/lib/btw/set-password ]; then
    printf '\n  Welcome to btw. Choose a password:\n  sudo asks for it.\n\n'
    tries=0
    until sudo -n /usr/local/lib/btw/set-password; do
        tries=$((tries + 1))
        if [ $tries -ge 3 ] || [ ! -e /var/lib/btw/choose-password ]; then
            printf '\n  Later: sudo /usr/local/lib/btw/set-password\n'
            sleep 3
            break
        fi
        printf '\n  Try again.\n\n'
    done
    clear
fi
# The live USB (the PC ISO): say how to install it and get online.
if [ -d /run/archiso ]; then
    printf '\n  This is btw from the USB stick: try it out, nothing is saved.\n'
    printf '  Install btw (app menu) puts it on this PC. Wi-Fi (app menu) gets you online.\n\n'
fi
command -v fastfetch >/dev/null && fastfetch -c /usr/share/btw/config/fastfetch/config.jsonc
exec "${SHELL:-bash}"
