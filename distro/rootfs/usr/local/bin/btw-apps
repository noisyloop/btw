#!/bin/sh
# Lists the installed apps for the btw app menu, one per line, tab-separated:
#   id  name  description  icon  categories  keywords
# Reads the .desktop files in the XDG data dirs. The first file with a given
# id wins, so ~/.local/share/applications can override or hide system apps.
set -u

dirs="${XDG_DATA_HOME:-$HOME/.local/share}:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"

IFS=:
for d in $dirs; do
    [ -d "$d/applications" ] || continue
    find "$d/applications" -name '*.desktop' 2>/dev/null | while read -r f; do
        # The id is the path below applications/, with / turned into -.
        id=${f#"$d/applications/"}
        id=$(printf '%s' "${id%.desktop}" | tr / -)
        printf '%s\t%s\n' "$id" "$f"
    done
done | awk -F '\t' '
    # Keep the first file for each id.
    seen[$1]++ { next }
    {
        id = $1; file = $2
        name = generic = comment = icon = cats = kw = ""
        type = ""; hide = 0; section = 0
        while ((getline line < file) > 0) {
            if (line ~ /^\[/) { section = (line == "[Desktop Entry]"); continue }
            if (!section) continue
            eq = index(line, "="); if (!eq) continue
            k = substr(line, 1, eq - 1); v = substr(line, eq + 1)
            gsub(/\t/, " ", v)
            if (k == "Type") type = v
            else if (k == "Name") name = v
            else if (k == "GenericName") generic = v
            else if (k == "Comment") comment = v
            else if (k == "Icon") icon = v
            else if (k == "Categories") cats = v
            else if (k == "Keywords") kw = v
            else if ((k == "NoDisplay" || k == "Hidden") && v == "true") hide = 1
            else if (k == "OnlyShowIn" && v !~ /(^|;)(sway|btw)(;|$)/) hide = 1
            else if (k == "NotShowIn" && v ~ /(^|;)(sway|btw)(;|$)/) hide = 1
        }
        close(file)
        if (type != "Application" || hide || name == "") next
        desc = generic != "" ? generic : comment
        print id "\t" name "\t" desc "\t" icon "\t" cats "\t" kw
    }'
