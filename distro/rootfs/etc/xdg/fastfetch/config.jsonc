// btw's fastfetch: a small Sierpinski triangle and a short list, sized for a
// terminal window rather than a whole screen. btw's welcome terminal runs
// `fastfetch -c /usr/share/btw/config/fastfetch/config.jsonc`, so a system or
// user fastfetch config (e.g. Omarchy's) is left alone.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/btw/config/fastfetch/logo.txt",
    // mint -> teal, the wallpaper's ramp
    "color": {
      "1": "38;2;61;220;151",
      "2": "38;2;63;190;160",
      "3": "38;2;56;160;170",
      "4": "38;2;46;143;163"
    },
    "padding": { "top": 0, "left": 2, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "38;2;61;220;151", "title": "38;2;232;162;74" },
    "key": { "width": 8 }
  },
  "modules": [
    "title",
    { "type": "custom", "format": "\u001b[38;2;36;48;42m────────────────────\u001b[0m" },
    { "type": "os", "key": "os", "format": "{name} · btw" },
    { "type": "kernel", "key": "kernel", "format": "{release}" },
    { "type": "wm", "key": "wm", "format": "{pretty-name}" },
    { "type": "terminal", "key": "term", "format": "{pretty-name}" },
    { "type": "memory", "key": "mem", "format": "{used} / {total}" },
    { "type": "uptime", "key": "up" },
    { "type": "colors", "symbol": "circle", "paddingLeft": 0 }
  ]
}
