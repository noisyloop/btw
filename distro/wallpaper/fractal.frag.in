#version 440
// The live wallpaper: a raymarched 3D fractal with a slowly orbiting camera.
// Ported from desktop/wallpaper.js. build-shaders.sh puts each fractal's
// distance estimator into DE() below.
layout(location = 0) in vec2 qt_TexCoord0;
layout(location = 0) out vec4 fragColor;

layout(std140, binding = 0) uniform buf {
    mat4 qt_Matrix;
    float qt_Opacity;
    vec2 res;
    float time;
    float hue;
    float glow;
    float dist;
};

float DE(vec3 p) {
@DE@
}

// The theme's ramp, looping: mint -> teal -> amber -> mint.
vec3 tint(float t) {
    t = fract(t) * 3.0;
    vec3 mint = vec3(0.239, 0.863, 0.592);
    vec3 teal = vec3(0.180, 0.560, 0.640);
    vec3 amber = vec3(0.910, 0.635, 0.290);
    if (t < 1.0) return mix(mint, teal, smoothstep(0.0, 1.0, t));
    if (t < 2.0) return mix(teal, amber, smoothstep(1.0, 2.0, t));
    return mix(amber, mint, smoothstep(2.0, 3.0, t));
}

void main() {
    vec2 frag = vec2(qt_TexCoord0.x, 1.0 - qt_TexCoord0.y) * res;
    vec2 uv = (frag * 2.0 - res) / res.y;
    float a = time * 0.045;
    vec3 ro = dist * vec3(sin(a), 0.32 + 0.18 * sin(a * 0.63), cos(a));
    vec3 ww = normalize(-ro);
    vec3 uu = normalize(cross(ww, vec3(0.0, 1.0, 0.0)));
    vec3 vv = cross(uu, ww);
    vec3 rd = normalize(uv.x * uu + uv.y * vv + 1.7 * ww);

    float t = 0.0;
    float steps = 0.0;
    bool hit = false;
    for (int i = 0; i < 96; i++) {
        float h = DE(ro + rd * t);
        if (h < 0.0012 * t) { hit = true; break; }
        t += h;
        steps += 1.0;
        if (t > 24.0) break;
    }

    vec3 bg = mix(vec3(0.027, 0.07, 0.058), vec3(0.085, 0.028, 0.07), clamp(uv.y * 0.4 + 0.5, 0.0, 1.0));
    vec3 col = bg;
    float trap = steps / 96.0;
    float h0 = hue + time * 0.004;

    if (hit) {
        vec3 p = ro + rd * t;
        vec2 e = vec2(0.0008 * t + 0.0004, 0.0);
        vec3 n = normalize(vec3(
            DE(p + e.xyy) - DE(p - e.xyy),
            DE(p + e.yxy) - DE(p - e.yxy),
            DE(p + e.yyx) - DE(p - e.yyx)));
        vec3 light = normalize(vec3(0.5, 0.8, 0.3));
        float diff = clamp(dot(n, light), 0.0, 1.0);
        float rim = pow(clamp(1.0 + dot(n, rd), 0.0, 1.0), 3.0);
        float occ = clamp(1.0 - trap * 1.4, 0.15, 1.0);
        vec3 base = tint(fract(trap * 1.6 + h0));
        col = base * (0.22 + 0.78 * diff) * occ * glow;
        col += rim * 0.35 * tint(h0 + 0.5);
        col = mix(col, bg, 1.0 - exp(-0.012 * t * t));
    }
    // Halo from rays that grazed the surface.
    col += tint(h0 + 0.08) * trap * trap * 0.45 * glow;
    col *= 1.0 - 0.32 * dot(uv * 0.55, uv * 0.55);
    fragColor = vec4(pow(max(col, 0.0), vec3(0.9)), 1.0) * qt_Opacity;
}
